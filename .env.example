# Environment template only. The app does not automatically read this file.
# Run scripts/configure-auth.py to create a private .env; then use scripts/run.sh.
BMON_USERNAME=
BMON_PASSWORD_HASH=
BMON_PUBLIC_ORIGIN=http://localhost:8080
BMON_HOST=127.0.0.1
BMON_PORT=8080
# Optional storage paths; omit to use the public checkout's ignored data directory.
# BMON_DATA_DIR=
# BMON_MEDIA_MOUNT=
# BMON_MEDIA_DIR=
BMON_MODEL_ENABLED=false
BMON_VLM_ENABLED=false
# Temporary adult engineering test; default baby prompt remains unchanged.
BMON_PERSON_TEST_MODE=false
BMON_VLM_SERVICE_URL=http://127.0.0.1:8010
# Skip vision analysis below this mean frame brightness (0-255); 0 disables.
# BMON_VLM_MIN_BRIGHTNESS=40
BMON_VOICE_ENABLED=false
# Cry detection runs 24h with the microphone; no audio is stored.
# BMON_CRY_ENABLED=true
# BMON_CRY_THRESHOLD=0.5
# BMON_SPEAKER_HOST=
# BMON_SPEAKER_NAME=
# BMON_BLUETOOTH_SPEAKER_MAC=
# Bluetooth speaker through PulseAudio + GStreamer (system Python with python3-gi).
# BMON_PLAYBACK_BACKEND=pulse
# BMON_PULSE_PYTHON=/usr/bin/python3
# Use only for no-output control testing without a connected speaker.
# BMON_PLAYBACK_BACKEND=silent
# BMON_VLM_MODEL_PATH=
# BMON_FACE_MODEL_PATH=
# BMON_POSTURE_MODEL_PATH=
# Set true for a hardware-free geometric camera demo.
BMON_DEMO=true

# Staged Assistant development: disabled until backend/frontend and GPU acceptance.
BMON_ASSISTANT_ENABLED=false
# Isolated model tests only; leave false on a live visual monitoring worker.
BMON_ASSISTANT_ALLOW_UNPROFILED_CHAT=false
