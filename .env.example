# Environment template only. The app does not automatically read this file.
# Run scripts/configure-auth.py to create a private .env; then use scripts/run.sh.
BMON_USERNAME=
BMON_PASSWORD_HASH=
BMON_PUBLIC_ORIGIN=http://localhost:8080
BMON_HOST=127.0.0.1
BMON_PORT=8080
# Optional storage paths; omit to use the public checkout's ignored data directory.
# BMON_DATA_DIR=
# BMON_MEDIA_MOUNT=
# BMON_MEDIA_DIR=
BMON_MODEL_ENABLED=false
BMON_VLM_ENABLED=false
# Temporary adult engineering test; default baby prompt remains unchanged.
BMON_PERSON_TEST_MODE=false
BMON_VLM_SERVICE_URL=http://127.0.0.1:8010
BMON_VOICE_ENABLED=false
# BMON_SPEAKER_HOST=
# BMON_SPEAKER_NAME=
# BMON_BLUETOOTH_SPEAKER_MAC=
# Use only for no-output control testing without a connected speaker.
# BMON_PLAYBACK_BACKEND=silent
# BMON_VLM_MODEL_PATH=
# BMON_FACE_MODEL_PATH=
# BMON_POSTURE_MODEL_PATH=
# Set true for a hardware-free geometric camera demo.
BMON_DEMO=true
